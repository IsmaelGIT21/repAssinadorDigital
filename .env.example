# Copy this file to .env and fill in the values. NEVER commit .env.
# .env is read by Docker Compose and by the application itself (spring.config.import).
# Docker Compose expands "$" inside values: write "$$" for a literal "$".

# MongoDB
MONGODB_DATABASE=digital-signature
MONGODB_USERNAME=root
MONGODB_PASSWORD=change-me

# PKCS#12 signing certificate (file in ./secrets, never committed).
CERTIFICATE_PATH=./secrets/certificado.p12
CERTIFICATE_PASSWORD=change-me
CERTIFICATE_COMMON_NAME=Digital Signature Platform Development CA
CERTIFICATE_VALIDITY_TIME=1440
CERTIFICATE_LOCATION=BR
# Optional RFC 3161 time-stamp authority. Leave empty to disable.
CERTIFICATE_TSA_URL=

# SMTP account used for verification, invitation and password-reset messages.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=change-me@example.com
MAIL_PASSWORD=change-me
MAIL_FROM=change-me@example.com

# In-memory test login.
APP_TEST_USER_EMAIL=usuario@teste.com
APP_TEST_USER_PASSWORD=change-me

APP_BASE_URL=http://localhost:8080
